{
  "expo": {
    "name": "Wavo ويفو",
    "slug": "wavo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "wavo",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.wavo.naqla",
      "minSdkVersion": 26,
      "targetSdkVersion": 35,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE",
        "CHANGE_NETWORK_STATE",
        "ACCESS_NETWORK_STATE",
        "INTERNET",
        "CAMERA",
        "BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Wavo (ويفو) to use the camera so you can scan the sender's QR code."
        }
      ],
      "./plugins/withNaQlaWifi"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
